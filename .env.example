# Oracle Database
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=ORCL
ORACLE_USER=your_username
ORACLE_PASSWORD=your_password

# Mock Mode (ตั้งเป็น true เพื่อทดสอบโดยไม่ต้องเชื่อม Oracle DB)
USE_MOCK_DATA=true

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Rate Limit
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000

# Geolocation
MAX_DISTANCE_METERS=50

# Extra offices (หน่วยงานเพิ่มเติมที่ไม่ได้มาจาก database)
# JSON array ของ objects ที่มี org_code และ org_name
# ตัวอย่าง: EXTRA_OFFICES='[{"org_code":"EXT001","org_name":"หน่วยงานทดสอบ"},{"org_code":"EXT002","org_name":"สำนักงานภายนอก"}]'
EXTRA_OFFICES='[]'

# Timezone
TZ=Asia/Bangkok
